# Copy to .env (cp .env.example .env). Used by docker compose AND the backend in dev.

# --- Postgres ---
POSTGRES_USER=papertrade
POSTGRES_PASSWORD=papertrade
POSTGRES_DB=papertrade
POSTGRES_PORT=5432

# --- Backend (host-side dev values; compose overrides hostnames for the containerised app) ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://papertrade:papertrade@localhost:5432/papertrade?schema=public
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=papertrade

# --- Auth (P1) ---
APP_BASE_URL=http://localhost:3000
WEB_APP_URL=http://localhost:3000
STARTING_CASH=1000000
# OAuth apps. Callback URLs: {APP_BASE_URL}/auth/google/callback and {APP_BASE_URL}/auth/github/callback
# A provider is enabled only when both its id and secret are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
